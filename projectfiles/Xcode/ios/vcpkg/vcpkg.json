    "libvorbis",
    "libogg",
    "wavpack",
    "bzip2",
    "zlib",
    "openssl",
    "fontconfig",
    "cairo",
    "pango",
    "gettext-libintl",
    "boost-algorithm",
    "boost-any",
    "boost-asio",
    "boost-bimap",
    "boost-charconv",
    "boost-circular-buffer",
    "boost-core",
    "boost-coroutine",
    "boost-date-time",
    "boost-dynamic-bitset",
    "boost-exception",
    "boost-filesystem",
    "boost-format",
    "boost-fusion",
    "boost-graph",
    "boost-iostreams",
    "boost-iterator",
    "boost-locale",
    "boost-logic",
    "boost-math",
    "boost-multi-array",
    "boost-multi-index",
    "boost-optional",
    "boost-phoenix",
    "boost-predef",
    "boost-preprocessor",
    "boost-program-options",
    "boost-ptr-container",
    "boost-random",
    "boost-range",
    "boost-regex",
    "boost-scope-exit",
